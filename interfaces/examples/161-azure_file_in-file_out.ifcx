formatVersion: 1

general: {}

sourceInterface: azure_file_in

destinationInterfaces:
  - file_out

# For the 'azure_file_in' reader, define a bucket-/container-list as source entities!
processSourceEntities:
  - autumo

sources:
  - name: azure_file_in

    params:

      #
      # Azure connection string. You find it in 'Access Keys'
      # in the Azure portal.
      #
      # We don't recommend using this access method! If left
      # blank, the default and more secure authentication
      # chain is used.
      #
      # This value can be encrypted, use encoder.sh.
      #
      connection_string: "<YOUR_CONNECTION_STRING>"

      #
      # Azure account name.
      #
      account: "<YOUR_ACCOUNT_NAME>"

      #
      # Temporary directory for files read from the Azure Blob Storage.
      #
      temp_out_path: /Volumes/Fastdrive/tmp/ifacex

    entities:
      autumo: {}

destinations:
  - name: file_out

    params:

      #
      # Output directory.
      #
      path: /Volumes/Fastdrive/tmp/fromaz

      #
      # Delete source files after copying?
      # Values: yes|no
      #
      delete_files_after_processing: "yes"
