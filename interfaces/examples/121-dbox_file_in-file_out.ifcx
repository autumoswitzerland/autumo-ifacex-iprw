###############################################################################

formatVersion: 1

general: {}

sourceInterface: dbox_file_in

destinationInterfaces:
  - file_out

# For the 'gdrive_file_in' reader, define a spaces-list as source entities or
# use 'NULL' if you want to access the default google drive space.
processSourceEntities:
  - "NULL"

sources:
  - name: dbox_file_in

    params:

      #
      # App name you could provide.
      # Can be left empty.
      #
      app_name: ""

      #
      # App version you could provide.
      # Can be left empty.
      #
      app_version: ""

      #
      # Dropbox OAuth 2.0 access token.
      #
      oauth_access_token: "<YOUR_ACCESS_TOKEN>"

      #
      # From what path should be read?
      # '/' is the root directory, but it is unsupported!
      #
      path: /test

      #
      # Temporary directory for files read from Dropbox.
      #
      temp_out_path: /Volumes/Fastdrive/tmp/ifacex

    entities:
      NULL: {}

destinations:
  - name: file_out

    params:

      #
      # Output directory.
      #
      path: /Volumes/Fastdrive/tmp/fromdb

      #
      # Delete source files after copying?
      # Values: yes|no
      #
      delete_files_after_processing: "no"
