formatVersion: 1

general: {}

sourceInterface: b2_file_in

destinationInterfaces:
  - file_out

# For the 'b2_file_in' reader, define a bucket-list as source entities!
processSourceEntities:
  - autumo

sources:
  - name: b2_file_in

    params:

      #
      # B2 API key ID.
      #
      # This value can be encrypted, use encoder.sh.
      #
      api_key_id: "<YOUR_API_KEY_ID>"

      #
      # B2 API key.
      #
      # This value can be encrypted, use encoder.sh.
      #
      api_key: "<YOUR_API_KEY>"

      #
      # Temporary directory for files read from the Azure Blob Storage.
      #
      temp_out_path: /Volumes/Fastdrive/tmp/ifacex

    entities:
      autumo: {}

destinations: []
