formatVersion: 1

general: {}

sourceInterface: file_in

destinationInterfaces:
  - webdav_file_out

# In this case, you define one pseudo entity, that defines in which
# directory files should be read and processed as source entities
# for the 'file_in'-reader
processSourceEntities:
  - "files:/Volumes/Fastdrive/autumo/docs/WEBDAV"

sources: []

destinations:
  - name: webdav_file_out

    params:

      #
      # Base URL with port.
      #
      url: "https://192.168.0.14:5000"

      #
      # Secure SSL/TLS?
      # Values: yes|no
      #
      ssl: "yes"

      #
      # User (can be encrypted, use encoder.sh).
      #
      user: autumo

      #
      # Password (can be encrypted, use encoder.sh).
      #
      password: autumo

      #
      # Temporary directory for files read from Web DAV.
      #
      dest_uri: "<UPLOAD_DIRECTORY>"

      #
      # Does server allow to delete files?
      # Values: yes|no
      #
      allow_delete: "yes"
