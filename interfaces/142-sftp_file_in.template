formatVersion: 1

general: {}

sourceInterface: sftp_file_in

destinationInterfaces:
  - file_out

# For the 'sftp_file_in' reader, define entities that serve as directory paths
# in the remote FTP location.
processSourceEntities:
  - upload/juhu

sources:
  - name: sftp_file_in

    params:

      #
      # Host.
      #
      host: localhost

      #
      # Port.
      #
      port: "22"

      #
      # User (can be encrypted, use encoder.sh).
      #
      user: "<YOUR_USER>"

      #
      # Password (can be encrypted, use encoder.sh).
      #
      password: "<YOUR_PASSWORD>"

      #
      # Known Hosts file path.
      #
      known_hosts: "<PATH_TO>/known_hosts"

      #
      # Temporary directory for files read from FTP.
      #
      temp_out_path: /Volumes/Fastdrive/tmp/ifacex

    entities:
      upload/juhu: {}

destinations: []
