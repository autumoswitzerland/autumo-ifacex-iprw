# .env for local integration tests (run-integration-tests.sh)
# Copy this file to ".env" (repo root or bin/) and fill in your values.
# ".env" is gitignored - never commit real credentials.

# --- FTP / SFTP (e.g. your web hoster) ---
FTP_TEST_HOST=
FTP_TEST_PORT=21
FTP_TEST_USER=
FTP_TEST_PASSWORD=
FTP_TEST_DIR=/

SFTP_TEST_HOST=
SFTP_TEST_PORT=22
SFTP_TEST_USER=
SFTP_TEST_PASSWORD=
SFTP_TEST_DIR=/

# --- WebDAV ---
WEBDAV_TEST_URL=
WEBDAV_TEST_USER=
WEBDAV_TEST_PASSWORD=

# --- AWS S3 ---
AWS_TEST_ACCESS_KEY=
AWS_TEST_SECRET_KEY=
AWS_TEST_REGION=
AWS_TEST_BUCKET=
# Custom S3 endpoint, e.g. http://localhost:9090; empty = real AWS
AWS_TEST_URL_ENDPOINT=
# Set to 1 to use the local S3 emulator (mod-az-aws-s3/test/docker.sh start)
AWS_TEST_EMULATOR=

# --- Backblaze B2 ---
B2_TEST_KEY_ID=
B2_TEST_APP_KEY=
B2_TEST_BUCKET=

# --- Dropbox ---
DROPBOX_TEST_TOKEN=
# Path to a folder containing files (not just subfolders), e.g., '/public/specific-folder-with-files'
# Note: The Dropbox reader will fail with "not_file" if the specified path contains only folders.
# Ensure your test path contains actual files.
DROPBOX_TEST_PATH=/
DROPBOX_TEST_APP_NAME=ifaceX
DROPBOX_TEST_APP_VERSION=1.0

# --- Google Drive ---
GDRIVE_TEST_CLIENT_ID=
GDRIVE_TEST_CLIENT_SECRET=
GDRIVE_TEST_REFRESH_TOKEN=
GDRIVE_TEST_FOLDER=

# --- Google Cloud Storage ---
GCS_TEST_PROJECT_ID=
GCS_TEST_CREDENTIALS_JSON=
GCS_TEST_BUCKET=

# --- Azure Blob Storage ---
AZURE_TEST_CONNECTION_STRING=
AZURE_TEST_CONTAINER=
AZURE_TEST_ACCOUNT=
# Set to 1 to use the local Azurite emulator (mod-ms-azure/test/docker.sh start)
AZURE_TEST_EMULATOR=

# --- OpenStack Swift ---
OS_TEST_URL=
OS_TEST_USER=
OS_TEST_PASSWORD=
OS_TEST_PROJECT=
OS_TEST_DOMAIN=
OS_TEST_CONTAINER=

# --- Apache NiFi Site-to-Site ---
NIFI_TEST_URL=
NIFI_TEST_PORT_NAME=
